/shots/*
  Cache-Control: public, max-age=86400
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
  # The watcher's page (watch/page.js) uses the same face, and a browser takes a font from another site only when it says so.
  Access-Control-Allow-Origin: https://watch.elyir.com
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
# The privacy page says a visit loads nothing from any other site. This holds it even when something at the edge adds a
# script on the way out, such as Cloudflare's own visitor beacon: the browser refuses it and anything it would send.
/
  Content-Security-Policy: script-src 'self'; connect-src 'self'
/privacy
  Content-Security-Policy: script-src 'self'; connect-src 'self'
