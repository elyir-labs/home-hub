{
  "name": "home-hub-matter-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "The house, published as one Matter bridge, for Apple Home, Google Home and Alexa",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/main.js",
    "test": "tsc -p tsconfig.json && node --test dist/**/*.test.js"
  },
  "dependencies": {
    "@matter/main": "0.17.9",
    "@matter/nodejs": "0.17.9",
    "ws": "8.18.3"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/ws": "8.5.13",
    "typescript": "5.7.2"
  }
}
