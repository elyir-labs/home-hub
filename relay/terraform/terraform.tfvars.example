# Copy to terraform.tfvars and fill in. terraform.tfvars is gitignored: it holds the auth token.
#
# The two API tokens are NOT here and never are -- they come from the environment:
#
#   export CLOUDFLARE_API_TOKEN=...   # scoped to the elyir.app zone: DNS edit, SSL and Certificates edit
#                                     # and, for mail, Zone Settings edit and Email Routing Rules edit
#                                     # on the zone, plus Email Routing Addresses edit on the account
#   export HCLOUD_TOKEN=...           # a project token, read and write
#
# Those two are the only things minted by hand in this whole design, because they are the
# credentials Terraform authenticates with and nothing can create them for you.

# What stops any frpc on the internet registering a proxy on the relay. Generate it with:
#   openssl rand -hex 32
relay_auth_token = ""

# The operator's public key, so there is a way back into the box. `cat ~/.ssh/id_ed25519.pub`
admin_ssh_public_key = ""

# Narrow this to your own address if it is ever static. Password authentication is off regardless.
# admin_cidrs = ["203.0.113.4/32"]

# Bring your own box instead of renting one here: set this and nothing is created.
# relay_ipv4 = ""

# Mail on the zone (email.tf). Each key is the part before the @; each value, the mailboxes it forwards
# to. Every new mailbox is sent a link by Cloudflare and gets nothing until somebody clicks it.
# email_forwards = {
#   security = ["you@example.com"]
# }
# Anything sent to an address not listed above. Empty drops it.
# email_catch_all = []

# The sender's key for Apple's push service (relay/service/push.py), so houses can tell phones in the store app.
# The .p8 is shown once by Apple when it is made (Certificates, Identifiers & Profiles > Keys, with Apple Push
# Notifications service on). Paste the whole file between the markers; never commit it. All three, or none:
# left empty, the sender answers 503 and houses keep their phones until it is on. Changing them replaces the box
# on the next `terraform apply`, like any change to what cloud-init writes; the volume carries every house across.
# apns_key = <<-EOT
#   -----BEGIN PRIVATE KEY-----
#   ...
#   -----END PRIVATE KEY-----
# EOT
# apns_key_id  = ""
# apns_team_id = ""
