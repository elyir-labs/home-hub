#cloud-config
# What the box runs, written once at first boot so the server is reproducible rather than
# remembered. Four things, each a container with a systemd unit:
#
#   frps            the relay itself, on 443: carries every house's bytes and reads none of them
#   relay-service   the registration service: names, entitlements, frps's yes or no, and the nameserver
#                   for home.elyir.app on 53 -- each house's name at home (relay/service)
#   relay-api-door  a Caddy holding api.elyir.app's certificate, so hubs can reach the service
#   relay-api-frpc  how that Caddy is reached: through frps, exactly the way a house's door is
#   relay-printers-frpc  the same for printers.elyir.app, the printer app's static files, which that
#                   Caddy also serves (relay/README.md, *The printer app*)
#   relay-houses-frpc    and for houses.elyir.app, the Houses app, served the same way (*The Houses app*)
#
# The service's file and Caddy's certificate live on a Hetzner volume mounted at /var/lib/relay, so a
# rebuilt box comes back knowing every house, without asking Let's Encrypt for api.elyir.app again.

package_update: true
package_upgrade: true
packages:
  - docker.io
  # Debian's docker refuses to start a container when the kernel has AppArmor on and the parser is
  # missing, and Hetzner's debian-12 image ships without it. Found 1 October 2026: the first box
  # came up with frps restarting every five seconds and nothing on 443.
  - apparmor
  # The service is built on the box from this repository at a pinned ref (relay_service_ref), which
  # needs git for docker to fetch it. No registry and no image to publish: the code that runs is the
  # code at that commit, readable by anyone, which is the point of the service being AGPL.
  - git

write_files:
  # The relay. NOT here, deliberately: any `plugin` line on a proxy. frp ships an `https2http` plugin
  # that terminates TLS, and the relay's whole claim -- that it carries bytes it cannot read -- is a
  # property of not using one. docs/away.md, *What was verified*. The httpPlugins block below is a
  # different thing: frps asking the service whether to carry a house at all, before any byte moves.
  - path: /etc/frp/frps.toml
    permissions: '0600'
    owner: root:root
    content: |
      bindPort = 443
      vhostHTTPSPort = 443

      # Not the gate -- every hub has it. The gate is the plugin below, which checks each house's own
      # secret and entitlement (relay/service/registry.py, judge).
      auth.method = "token"
      auth.token = "${auth_token}"

      log.to = "console"
      log.level = "info"

      # Names are not logged with the bytes: what this box can see is which house, when, and how
      # much, which is what docs/service.md promises out loud and nothing more.
      log.maxDays = 7

      # Checked against frps 0.71.0 on 1 October 2026: a refused Login or NewProxy reaches the hub as
      # the reason given, and with the service down frps refuses new logins rather than letting them
      # through. Tunnels already open stay open, so a restart of the service is not an outage.
      [[httpPlugins]]
      name = "houses"
      addr = "127.0.0.1:7100"
      path = "/frps"
      ops = ["Login", "NewProxy"]

  # The service's own name, as frpc sees it: one more house on this relay, always carried, whose door
  # is the Caddy below. Its secret is seeded into the service at start (RELAY_SELF_SECRET).
  - path: /etc/frp/api-frpc.toml
    permissions: '0600'
    owner: root:root
    content: |
      serverAddr = "127.0.0.1"
      serverPort = 443
      loginFailExit = false
      auth.method = "token"
      auth.token = "${auth_token}"
      user = "api"
      metadatas.house = "api"
      metadatas.secret = "${self_secret}"
      transport.tls.disableCustomTLSFirstByte = false
      log.to = "console"

      [[proxies]]
      name = "door"
      type = "https"
      customDomains = ["api.${zone}"]
      localIP = "127.0.0.1"
      localPort = 9443
      transport.proxyProtocolVersion = "v2"

  # printers.elyir.app, the same way: one more always-carried name whose door is the Caddy below.
  - path: /etc/frp/printers-frpc.toml
    permissions: '0600'
    owner: root:root
    content: |
      serverAddr = "127.0.0.1"
      serverPort = 443
      loginFailExit = false
      auth.method = "token"
      auth.token = "${auth_token}"
      user = "printers"
      metadatas.house = "printers"
      metadatas.secret = "${printers_secret}"
      transport.tls.disableCustomTLSFirstByte = false
      log.to = "console"

      [[proxies]]
      name = "door"
      type = "https"
      customDomains = ["printers.${zone}"]
      localIP = "127.0.0.1"
      localPort = 9443
      transport.proxyProtocolVersion = "v2"

  # houses.elyir.app, the same way again: the Houses app's static files, from the same Caddy.
  - path: /etc/frp/houses-frpc.toml
    permissions: '0600'
    owner: root:root
    content: |
      serverAddr = "127.0.0.1"
      serverPort = 443
      loginFailExit = false
      auth.method = "token"
      auth.token = "${auth_token}"
      user = "houses"
      metadatas.house = "houses"
      metadatas.secret = "${houses_secret}"
      transport.tls.disableCustomTLSFirstByte = false
      log.to = "console"

      [[proxies]]
      name = "door"
      type = "https"
      customDomains = ["houses.${zone}"]
      localIP = "127.0.0.1"
      localPort = 9443
      transport.proxyProtocolVersion = "v2"

  # nearby.elyir.app: one more always-carried name, answering "which printers are on this Wi-Fi".
  - path: /etc/frp/nearby-frpc.toml
    permissions: '0600'
    owner: root:root
    content: |
      serverAddr = "127.0.0.1"
      serverPort = 443
      loginFailExit = false
      auth.method = "token"
      auth.token = "${auth_token}"
      user = "nearby"
      metadatas.house = "nearby"
      metadatas.secret = "${nearby_secret}"
      transport.tls.disableCustomTLSFirstByte = false
      log.to = "console"

      [[proxies]]
      name = "door"
      type = "https"
      customDomains = ["nearby.${zone}"]
      localIP = "127.0.0.1"
      localPort = 9443
      transport.proxyProtocolVersion = "v2"

  # api.elyir.app's door. The certificate is proved over TLS-ALPN-01 through frps, the same way every
  # house proves its own, so no port opens for it and no DNS credential exists on this box. Only the
  # hub-facing routes are passed on; the plugin route answers frps on loopback and nobody else.
  - path: /etc/relay/Caddyfile
    permissions: '0644'
    owner: root:root
    content: |
      {
        servers 127.0.0.1:9443 {
          listener_wrappers {
            proxy_protocol {
              timeout 5s
              allow 127.0.0.1/32
            }
            tls
          }
        }
      }

      api.${zone}:9443 {
        bind 127.0.0.1
        tls {
          issuer acme {
            disable_http_challenge
            alt_tlsalpn_port 9443
          }
        }
        @public path /alive /offer /names/* /houses /houses/* /acme/*
        handle @public {
          reverse_proxy 127.0.0.1:7100
        }
        handle {
          respond 404
        }
      }

      # Which printers are on this Wi-Fi: the one route, and nothing else on this name.
      nearby.${zone}:9443 {
        bind 127.0.0.1
        tls {
          issuer acme {
            disable_http_challenge
            alt_tlsalpn_port 9443
          }
        }
        handle /nearby {
          reverse_proxy 127.0.0.1:7100
        }
        handle {
          respond 404
        }
      }

      # The printer app: static files and nothing else, published from its own repository into a
      # versioned directory on the volume, with `current` pointing at one. The camera is the page's own and
      # nobody else's: adding a printer scans the code on the printer's screen from inside the installed app. Every phone that uses it
      # trusts this code with its printers' tokens, so the page may talk to printer names under this
      # zone and nowhere else, may not be framed, and runs no script it did not ship with.
      printers.${zone}:9443 {
        bind 127.0.0.1
        tls {
          issuer acme {
            disable_http_challenge
            alt_tlsalpn_port 9443
          }
        }
        root * /srv/printers/current
        header {
          Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.${zone}; connect-src 'self' https://*.${zone} wss://*.${zone}; frame-src https://*.${zone}; worker-src 'self'; manifest-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
          X-Content-Type-Options nosniff
          Referrer-Policy no-referrer
          Permissions-Policy "camera=(self), microphone=(), geolocation=()"
          -Server
        }
        @hashed path /assets/*
        header @hashed Cache-Control "public, max-age=31536000, immutable"
        @fresh not path /assets/*
        header @fresh Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
      }

      # The Houses app: the phone's one app for every house it has joined, static files published from
      # this repository the way the printer app is published from its own. Each house's screen is
      # framed inside it from that house's own name, so the page may talk to and frame names under this
      # zone and nowhere else. It never uses the camera, the microphone or the location itself; it
      # only passes them on to the house it frames (voice, a camera, where home is), and to nothing else. Like the printer app, it may not be framed and runs no script it did not ship.
      houses.${zone}:9443 {
        bind 127.0.0.1
        tls {
          issuer acme {
            disable_http_challenge
            alt_tlsalpn_port 9443
          }
        }
        root * /srv/houses/current
        header {
          Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.${zone}; connect-src 'self' https://*.${zone} wss://*.${zone}; frame-src https://*.${zone}; worker-src 'self'; manifest-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; object-src 'none'"
          X-Content-Type-Options nosniff
          Referrer-Policy no-referrer
          Permissions-Policy `camera=("https://*.${zone}"), microphone=("https://*.${zone}"), geolocation=("https://*.${zone}")`
          -Server
        }
        @hashed path /assets/*
        header @hashed Cache-Control "public, max-age=31536000, immutable"
        @fresh not path /assets/*
        header @fresh Cache-Control "no-cache"
        try_files {path} /index.html
        file_server
      }

  - path: /etc/systemd/system/frps.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=frps, the relay
      After=docker.service
      Requires=docker.service

      [Service]
      Restart=always
      RestartSec=5
      ExecStartPre=-/usr/bin/docker rm -f frps
      ExecStartPre=/usr/bin/docker pull fatedier/frps:v${frp_version}
      ExecStart=/usr/bin/docker run --rm --name frps \
        --network host \
        -v /etc/frp/frps.toml:/etc/frp/frps.toml:ro \
        fatedier/frps:v${frp_version} -c /etc/frp/frps.toml
      ExecStop=/usr/bin/docker stop frps

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/relay-service.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=the registration service
      After=docker.service var-lib-relay.mount
      Requires=docker.service
      RequiresMountsFor=/var/lib/relay

      [Service]
      Restart=always
      RestartSec=5
      # Built once from the pinned ref; a rebuild is a new ref, which is a new box (relay.tf).
      ExecStartPre=/bin/sh -c 'docker image inspect relay-service:${service_ref} >/dev/null 2>&1 || docker build -t relay-service:${service_ref} "https://github.com/${repository}.git#${service_ref}:relay/service"'
      ExecStartPre=-/usr/bin/docker rm -f relay-service
      ExecStart=/usr/bin/docker run --rm --name relay-service \
        --network host \
        -v /var/lib/relay/service:/data \
        -e RELAY_ZONE=${zone} \
        -e RELAY_SELF_SECRET=${self_secret} \
        -e RELAY_PRINTERS_SECRET=${printers_secret} \
        -e RELAY_HOUSES_SECRET=${houses_secret} \
        -e RELAY_NEARBY_SECRET=${nearby_secret} \
        -e RELAY_NEARBY_ORIGINS=https://printers.${zone},https://houses.${zone} \
        -e RELAY_FRPS_TOKEN=${auth_token} \
        -e RELAY_OFFER_OPEN=${offer_open} \
        -e RELAY_DNS_PORT=53 \
        -e RELAY_NS=ns1.${zone} \
        relay-service:${service_ref}
      ExecStop=/usr/bin/docker stop relay-service

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/relay-api-door.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=api.${zone}'s door
      After=docker.service var-lib-relay.mount
      Requires=docker.service
      RequiresMountsFor=/var/lib/relay

      [Service]
      Restart=always
      RestartSec=5
      ExecStartPre=-/usr/bin/docker rm -f relay-api-door
      ExecStart=/usr/bin/docker run --rm --name relay-api-door \
        --network host \
        -v /etc/relay/Caddyfile:/etc/caddy/Caddyfile:ro \
        -v /var/lib/relay/caddy:/data \
        -v /var/lib/relay/printers:/srv/printers:ro \
        -v /var/lib/relay/houses:/srv/houses:ro \
        caddy:2
      ExecStop=/usr/bin/docker stop relay-api-door

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/relay-api-frpc.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=api.${zone} through the relay
      After=frps.service relay-service.service
      Requires=docker.service

      [Service]
      Restart=always
      RestartSec=5
      ExecStartPre=-/usr/bin/docker rm -f relay-api-frpc
      ExecStart=/usr/bin/docker run --rm --name relay-api-frpc \
        --network host \
        -v /etc/frp/api-frpc.toml:/etc/frp/frpc.toml:ro \
        fatedier/frpc:v${frp_version} -c /etc/frp/frpc.toml
      ExecStop=/usr/bin/docker stop relay-api-frpc

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/relay-printers-frpc.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=printers.${zone} through the relay
      After=frps.service relay-service.service
      Requires=docker.service

      [Service]
      Restart=always
      RestartSec=5
      ExecStartPre=-/usr/bin/docker rm -f relay-printers-frpc
      ExecStart=/usr/bin/docker run --rm --name relay-printers-frpc \
        --network host \
        -v /etc/frp/printers-frpc.toml:/etc/frp/frpc.toml:ro \
        fatedier/frpc:v${frp_version} -c /etc/frp/frpc.toml
      ExecStop=/usr/bin/docker stop relay-printers-frpc

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/relay-houses-frpc.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=houses.${zone} through the relay
      After=frps.service relay-service.service
      Requires=docker.service

      [Service]
      Restart=always
      RestartSec=5
      ExecStartPre=-/usr/bin/docker rm -f relay-houses-frpc
      ExecStart=/usr/bin/docker run --rm --name relay-houses-frpc \
        --network host \
        -v /etc/frp/houses-frpc.toml:/etc/frp/frpc.toml:ro \
        fatedier/frpc:v${frp_version} -c /etc/frp/frpc.toml
      ExecStop=/usr/bin/docker stop relay-houses-frpc

      [Install]
      WantedBy=multi-user.target

  - path: /etc/systemd/system/relay-nearby-frpc.service
    permissions: '0644'
    owner: root:root
    content: |
      [Unit]
      Description=nearby.${zone} through the relay
      After=frps.service relay-service.service
      Requires=docker.service

      [Service]
      Restart=always
      RestartSec=5
      ExecStartPre=-/usr/bin/docker rm -f relay-nearby-frpc
      ExecStart=/usr/bin/docker run --rm --name relay-nearby-frpc \
        --network host \
        -v /etc/frp/nearby-frpc.toml:/etc/frp/frpc.toml:ro \
        fatedier/frpc:v${frp_version} -c /etc/frp/frpc.toml
      ExecStop=/usr/bin/docker stop relay-nearby-frpc

      [Install]
      WantedBy=multi-user.target

runcmd:
  # Key-only, no root password, no sshd password prompt to brute force.
  - sed -i 's/^#\?PasswordAuthentication.*/PasswordAuthentication no/' /etc/ssh/sshd_config
  - sed -i 's/^#\?PermitRootLogin.*/PermitRootLogin prohibit-password/' /etc/ssh/sshd_config
  - systemctl restart ssh || systemctl restart sshd
  # The volume is attached after the box exists, so it is waited for rather than assumed. It arrives
  # formatted (relay.tf); fstab carries it across reboots, and nofail lets the box still boot -- and
  # still carry every open tunnel -- if it ever does not.
  - for i in $(seq 1 90); do [ -e ${volume_device} ] && break; sleep 2; done
  - mkdir -p /var/lib/relay
  - grep -q '${volume_device}' /etc/fstab || echo '${volume_device} /var/lib/relay ext4 defaults,nofail,discard 0 2' >> /etc/fstab
  - systemctl daemon-reload
  - mount /var/lib/relay
  - mkdir -p /var/lib/relay/service /var/lib/relay/caddy /var/lib/relay/printers /var/lib/relay/houses
  # The box's ssh identity lives on the volume too, so a rebuilt box is the same host to everyone who
  # has connected before. Found 2 October 2026: every rebuild changed the host key and ssh refused it.
  - if [ -d /var/lib/relay/ssh ]; then cp -p /var/lib/relay/ssh/ssh_host_* /etc/ssh/ && (systemctl restart ssh || systemctl restart sshd); else mkdir -p -m 700 /var/lib/relay/ssh && cp -p /etc/ssh/ssh_host_* /var/lib/relay/ssh/; fi
  - systemctl enable --now docker
  - systemctl enable --now relay-service
  - systemctl enable --now frps
  - systemctl enable --now relay-api-door
  - systemctl enable --now relay-api-frpc
  - systemctl enable --now relay-printers-frpc
  - systemctl enable --now relay-houses-frpc
  - systemctl enable --now relay-nearby-frpc
