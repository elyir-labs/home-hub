{
  "name": "app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:mock": "node mock/dev.mjs",
    "build": "vue-tsc -b && vite build",
    "dev:houses": "vite -c vite.houses.config.ts",
    "build:houses": "vue-tsc --noEmit -p tsconfig.houses.json && vite build -c vite.houses.config.ts",
    "preview": "vite preview",
    "mock": "node mock/brain.mjs",
    "brain": "cd ../brain && .venv/bin/python dev.py",
    "shots": "node mock/shots.mjs",
    "cost": "node mock/cost.mjs",
    "art-sheet": "node mock/art-sheet.mjs",
    "art-sheet:check": "node mock/art-sheet.mjs --check",
    "weather-sheet": "node mock/weather-sheet.mjs",
    "weather-sheet:check": "node mock/weather-sheet.mjs --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "vue-tsc -b",
    "lint": "eslint .",
    "lint:css": "stylelint \"src/**/*.css\" \"src/**/*.vue\" --max-warnings 21",
    "e2e": "playwright test",
    "e2e:watch": "playwright test --ui"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "vue": "^3.5.41"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitest/coverage-v8": "^5.0.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.10.0",
    "eslint-plugin-vue": "^10.11.0",
    "globals": "^17.12.0",
    "happy-dom": "^20.14.3",
    "playwright": "^1.63.0",
    "postcss-html": "^2.0.0",
    "stylelint": "^17.15.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.11"
  }
}
