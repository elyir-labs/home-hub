# The away door with no relay behind it: a house that has not turned on Reachable from outside.
# Plain http, because nothing on the other end could check a certificate, and loopback, because
# nothing on the Wi-Fi is meant to reach it. Steps 1 and 2 of docs/away.md were built and tested on
# this door, and a house stays on it until it has a name. on.caddy is the same door with one.
:9443 {
	# No host on the address on purpose: this door answers whatever Host a request claims, because the
	# claim is exactly what it must not be trusted on. `bind` is what keeps it off the Wi-Fi -- loopback
	# on the hub, and on the mac the container binds wide and the published port keeps it local.
	bind {$HUB_RELAY_BIND:127.0.0.1}
	encode gzip
	reverse_proxy {$BRAIN_UPSTREAM:localhost:8300} {
		header_up X-Hub-Via relay
	}
}
