# Watches for the file the brain writes when somebody asks for a restart the brain cannot do itself.
# install.sh copies this (with its own directory in place of /opt/home-hub) and enables it.
[Unit]
Description=Home Hub: watch for a restart request from the panel

[Path]
PathExists=/opt/home-hub/driver-layer/brain-data/restart.request
Unit=home-hub-restart.service

[Install]
WantedBy=multi-user.target
