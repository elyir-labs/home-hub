# Runs reset.sh once per request from the panel. Started by home-hub-reset.path; never on its own.
[Unit]
Description=Home Hub: start the hub over
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=HOME_HUB_DIR=/opt/home-hub
ExecStart=/opt/home-hub/driver-layer/host/reset.sh
StandardOutput=journal
TimeoutStartSec=0
