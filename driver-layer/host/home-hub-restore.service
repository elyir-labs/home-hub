# Runs restore.sh once per request from the panel. Started by home-hub-restore.path; never on its own.
[Unit]
Description=Home Hub: put a backup back
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=HOME_HUB_DIR=/opt/home-hub
ExecStart=/opt/home-hub/driver-layer/host/restore.sh
StandardOutput=journal
TimeoutStartSec=0
