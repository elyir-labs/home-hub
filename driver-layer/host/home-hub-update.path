# Watches for the file the brain writes when someone taps "install the update" on the panel.
# install.sh copies this (with its own directory in place of /opt/home-hub) and enables it.
[Unit]
Description=Home Hub: watch for an update request from the panel

[Path]
PathExists=/opt/home-hub/driver-layer/brain-data/update.request
Unit=home-hub-update.service

[Install]
WantedBy=multi-user.target
