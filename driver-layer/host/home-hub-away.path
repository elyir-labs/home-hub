# Watches for the file the brain writes when the house is to be reachable from outside, or not.
# install.sh copies this (with its own directory in place of /opt/home-hub) and enables it.
[Unit]
Description=Home Hub: watch for the panel turning outside on or off

[Path]
PathExists=/opt/home-hub/driver-layer/brain-data/away.request
Unit=home-hub-away.service

[Install]
WantedBy=multi-user.target
