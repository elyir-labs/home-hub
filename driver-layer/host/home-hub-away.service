# Runs away.sh once per request from the panel. Started by home-hub-away.path; never on its own.
[Unit]
Description=Home Hub: bring the way in from outside up or down
After=network-online.target docker.service

[Service]
Type=oneshot
Environment=HOME_HUB_DIR=/opt/home-hub
ExecStart=/opt/home-hub/driver-layer/host/away.sh
StandardOutput=journal
TimeoutStartSec=0
