# Watches for the file the brain writes when someone starts the hub over from the panel.
# install.sh copies this (with its own directory in place of /opt/home-hub) and enables it.
[Unit]
Description=Home Hub: watch for a request to start the hub over

[Path]
PathExists=/opt/home-hub/driver-layer/brain-data/reset.request
Unit=home-hub-reset.service

[Install]
WantedBy=multi-user.target
