# A light strip, on esp-matter.
#
# CONFIG_ENABLE_CHIPOBLE is what this whole project moved frameworks for: it defaults to y here and
# is unset in the Arduino build on every target, which is why a strip built that way can never
# advertise itself for commissioning. It is written out explicitly rather than left to a default,
# because it is the single setting the product depends on.
CONFIG_ENABLE_CHIPOBLE=y
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ENABLE_CONN_REATTEMPT=n

CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# The table is the one thing an update cannot change, so it was sized for Matter before anything
# shipped -- 3.75 MB an app slot, plus the two partitions a certified unit needs. partitions-matter.csv
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions-matter.csv"
CONFIG_PARTITION_TABLE_OFFSET=0x8000

# A crash in somebody's living room is otherwise undiagnosable: nobody is watching a serial port when
# it happens and the evidence is gone by the time anybody asks.
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

CONFIG_LWIP_IPV6_AUTOCONFIG=y
CONFIG_LWIP_HOOK_IP6_ROUTE_DEFAULT=y
CONFIG_LWIP_HOOK_ND6_GET_GW_DEFAULT=y
CONFIG_LWIP_IPV6_NUM_ADDRESSES=6

CONFIG_ENABLE_WIFI_AP=n
CONFIG_ESP_WIFI_SOFTAP_SUPPORT=n
CONFIG_ESP_MATTER_MAX_DYNAMIC_ENDPOINT_COUNT=2
CONFIG_MBEDTLS_HKDF_C=y
# ONE WAY IN, AND IT IS OURS (docs/strip.md, "Updates, the puck's way"). Matter's own updates reach a
# device only through a certified product in Matter's ledger or through a provider on the household's
# fabric, and we have neither and want neither. Updates come from the hub instead: main/fwupdate.h.
CONFIG_ENABLE_OTA_REQUESTOR=n

# ROLLBACK IN THE BOOTLOADER, WHICH ONLY A CABLE CAN PUT THERE. A new image boots on trial and is
# confirmed by main/fwupdate.cpp once it has reached the hub; one that never does -- or crashes before
# our code runs at all -- is taken back by the bootloader. A strip flashed without this can take an
# update and can never be saved from one, so it is here from the first flash, before any strip leaves.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y
CONFIG_MAX_GROUP_KEYS_PER_FABRIC=4

# TWO DAYS OF KNOCKING, NOT FIFTEEN MINUTES (design/strip/KnockTwoDays.dc.html), AND NOT THE WAY THE
# BOARD SAID. CHIP shuts a commissioning window after 900 seconds and our own door's scan response
# rides on that same advertisement, so both close together while network_provisioning still believes
# it is listening. CHIP's own answer is CONFIG_ENABLE_BLE_EXT_ANNOUNCEMENT, which lifts the ceiling
# to 48 hours -- and it does not compile: it is `default n`, nobody builds that path, and
# BLEManagerImpl.cpp:288 drops a nodiscard CHIP_ERROR under -Werror. Turning it on would mean
# patching vendored connectedhomeip, which lives outside this repository and so would not be a fix
# anybody else could reproduce. The window is reopened from our own code instead; see prov.cpp.
