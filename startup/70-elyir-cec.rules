# HDMI-CEC to the TV (startup/cec.sh). The Pulse-Eight USB adapter is a serial line until inputattach makes it a
# CEC device, and ModemManager would otherwise probe it as a modem. Installed by startup/install.sh.
SUBSYSTEM=="tty", ATTRS{idVendor}=="2548", ATTRS{idProduct}=="100[12]", ENV{ID_MM_DEVICE_IGNORE}="1", TAG+="systemd", ENV{SYSTEMD_WANTS}+="elyir-cec-attach@%k.service"
SUBSYSTEM=="cec", KERNEL=="cec[0-9]*", GROUP="video", MODE="0660", TAG+="systemd", ENV{SYSTEMD_WANTS}+="elyir-cec@%k.service"
