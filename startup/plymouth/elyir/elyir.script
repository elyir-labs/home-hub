# Elyir's startup. Generated by startup/render.mjs from startup/sequence.mjs -- edit those, not this.
#
# Plymouth calls refresh() fifty times a second. The name is written frame by frame, its i is
# dotted with a lamp that lights and breathes, the dot glides into the house, and the house waits
# breathing until the wall's service says the product is ready (plymouth update --status=elyir:ready).
# Then it opens onto the panel's own background, and the service hands the screen to the browser.

src = 1.3333;
fps = 25; name_frames = 66;
name_left = 322.5; name_top = 165;
tittle_x = 853.5; tittle_y = 327; tittle_size = 24;
house_left = 550; house_top = 260; house_size = 340;
lamp_x = 720; lamp_y = 463.2031; lamp_size = 39.8438;
dotted = 2.7; lit_at = 3.1; hold = 4.5; name_out = 0.9;
leave = 4.6; house_in = 5.2; land = 5.8;
ending = 0.9; ready_after = 6.2; slow_after = 180;
breath_period = 6.4; low = 0.72;
panel_r = 0.0471; panel_g = 0.051; panel_b = 0.0627;
pi = 3.14159265;

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
s = Math.Min(screen_w / 1440, screen_h / 900);
ox = (screen_w - 1440 * s) / 2;
oy = (screen_h - 900 * s) / 2;
r = s / src;
house_cx = ox + (house_left + house_size / 2) * s;
house_cy = oy + (house_top + house_size / 2) * s;

Window.SetBackgroundTopColor(0, 0, 0);
Window.SetBackgroundBottomColor(0, 0, 0);

fun clamp01(v) { if (v < 0) { return 0; } if (v > 1) { return 1; } return v; }
fun ramp(t, a, b) { return clamp01((t - a) / (b - a)); }
fun ease(x) { return x * x * (3 - 2 * x); }
fun breath(t) { return 0.5 + 0.5 * Math.Sin(t / breath_period * 2 * pi - pi / 2); }
fun pad(i) { if (i < 10) { return "0" + i; } return "" + i; }
fun fit(image) { if (r == 1) { return image; } return image.Scale(Math.Int(image.GetWidth() * r + 0.5), Math.Int(image.GetHeight() * r + 0.5)); }

# A sprite drawn from an image at a given width, centered on a point. Scaling is the expensive
# part, so it happens only when the width changes by a whole pixel; the width last used is
# kept in widths[] under the sprite's key.
fun place(key, sprite, image, cx, cy, w) {
  w = Math.Int(w + 0.5);
  if (w < 1) { w = 1; }
  if (global.widths[key] != w) {
    global.scaled[key] = image.Scale(w, Math.Int(w * image.GetHeight() / image.GetWidth() + 0.5));
    sprite.SetImage(global.scaled[key]);
    global.widths[key] = w;
  }
  sprite.SetX(cx - w / 2);
  sprite.SetY(cy - global.scaled[key].GetHeight() / 2);
}

dot_image = Image("dot.png");
unlit_image = Image("dot-unlit.png");
dot_glow_image = Image("dot-glow.png");
house_image = Image("house.png");
house_glow_image = Image("house-glow.png");

house_glow = Sprite(); house_glow.SetZ(4); house_glow.SetOpacity(0);
house = Sprite(); house.SetZ(5); house.SetOpacity(0);
name = Sprite(); name.SetZ(10); name.SetPosition(ox + name_left * s, oy + name_top * s, 10);
dot_glow = Sprite(); dot_glow.SetZ(20); dot_glow.SetOpacity(0);
unlit = Sprite(); unlit.SetZ(21); unlit.SetOpacity(0);
dot = Sprite(); dot.SetZ(22); dot.SetOpacity(0);
slow_image = fit(Image("slow.png"));
slow = Sprite(slow_image); slow.SetZ(30); slow.SetOpacity(0);
slow.SetPosition(Math.Int((screen_w - slow_image.GetWidth()) / 2), Math.Int(oy + 640 * s), 30);

# A first start's words (design/first-start/). Each step sends elyir:step:<step> as it starts, and the line under
# the house becomes that step's, with a quieter line under it where there is something to know. elyir:hello ends a
# first start on where to go next: elyir:addr, elyir:wifi or elyir:pass, then that hub's own words one character
# at a time as elyir:c:<character>, drawn from the letters below. A first start never shows the slow sentence.
global.step_line["preparing"] = fit(Image("step-preparing.png"));
global.step_line["moving"] = fit(Image("step-moving.png")); global.step_quiet["moving"] = fit(Image("quiet-moving.png"));
global.step_line["downloading"] = fit(Image("step-downloading.png"));
global.step_line["starting"] = fit(Image("step-starting.png"));
global.glyph["a"] = fit(Image("g-97.png")); global.char_of["elyir:c:a"] = "a";
global.glyph["b"] = fit(Image("g-98.png")); global.char_of["elyir:c:b"] = "b";
global.glyph["c"] = fit(Image("g-99.png")); global.char_of["elyir:c:c"] = "c";
global.glyph["d"] = fit(Image("g-100.png")); global.char_of["elyir:c:d"] = "d";
global.glyph["e"] = fit(Image("g-101.png")); global.char_of["elyir:c:e"] = "e";
global.glyph["f"] = fit(Image("g-102.png")); global.char_of["elyir:c:f"] = "f";
global.glyph["g"] = fit(Image("g-103.png")); global.char_of["elyir:c:g"] = "g";
global.glyph["h"] = fit(Image("g-104.png")); global.char_of["elyir:c:h"] = "h";
global.glyph["i"] = fit(Image("g-105.png")); global.char_of["elyir:c:i"] = "i";
global.glyph["j"] = fit(Image("g-106.png")); global.char_of["elyir:c:j"] = "j";
global.glyph["k"] = fit(Image("g-107.png")); global.char_of["elyir:c:k"] = "k";
global.glyph["l"] = fit(Image("g-108.png")); global.char_of["elyir:c:l"] = "l";
global.glyph["m"] = fit(Image("g-109.png")); global.char_of["elyir:c:m"] = "m";
global.glyph["n"] = fit(Image("g-110.png")); global.char_of["elyir:c:n"] = "n";
global.glyph["o"] = fit(Image("g-111.png")); global.char_of["elyir:c:o"] = "o";
global.glyph["p"] = fit(Image("g-112.png")); global.char_of["elyir:c:p"] = "p";
global.glyph["q"] = fit(Image("g-113.png")); global.char_of["elyir:c:q"] = "q";
global.glyph["r"] = fit(Image("g-114.png")); global.char_of["elyir:c:r"] = "r";
global.glyph["s"] = fit(Image("g-115.png")); global.char_of["elyir:c:s"] = "s";
global.glyph["t"] = fit(Image("g-116.png")); global.char_of["elyir:c:t"] = "t";
global.glyph["u"] = fit(Image("g-117.png")); global.char_of["elyir:c:u"] = "u";
global.glyph["v"] = fit(Image("g-118.png")); global.char_of["elyir:c:v"] = "v";
global.glyph["w"] = fit(Image("g-119.png")); global.char_of["elyir:c:w"] = "w";
global.glyph["x"] = fit(Image("g-120.png")); global.char_of["elyir:c:x"] = "x";
global.glyph["y"] = fit(Image("g-121.png")); global.char_of["elyir:c:y"] = "y";
global.glyph["z"] = fit(Image("g-122.png")); global.char_of["elyir:c:z"] = "z";
global.glyph["A"] = fit(Image("g-65.png")); global.char_of["elyir:c:A"] = "A";
global.glyph["B"] = fit(Image("g-66.png")); global.char_of["elyir:c:B"] = "B";
global.glyph["C"] = fit(Image("g-67.png")); global.char_of["elyir:c:C"] = "C";
global.glyph["D"] = fit(Image("g-68.png")); global.char_of["elyir:c:D"] = "D";
global.glyph["E"] = fit(Image("g-69.png")); global.char_of["elyir:c:E"] = "E";
global.glyph["F"] = fit(Image("g-70.png")); global.char_of["elyir:c:F"] = "F";
global.glyph["G"] = fit(Image("g-71.png")); global.char_of["elyir:c:G"] = "G";
global.glyph["H"] = fit(Image("g-72.png")); global.char_of["elyir:c:H"] = "H";
global.glyph["I"] = fit(Image("g-73.png")); global.char_of["elyir:c:I"] = "I";
global.glyph["J"] = fit(Image("g-74.png")); global.char_of["elyir:c:J"] = "J";
global.glyph["K"] = fit(Image("g-75.png")); global.char_of["elyir:c:K"] = "K";
global.glyph["L"] = fit(Image("g-76.png")); global.char_of["elyir:c:L"] = "L";
global.glyph["M"] = fit(Image("g-77.png")); global.char_of["elyir:c:M"] = "M";
global.glyph["N"] = fit(Image("g-78.png")); global.char_of["elyir:c:N"] = "N";
global.glyph["O"] = fit(Image("g-79.png")); global.char_of["elyir:c:O"] = "O";
global.glyph["P"] = fit(Image("g-80.png")); global.char_of["elyir:c:P"] = "P";
global.glyph["Q"] = fit(Image("g-81.png")); global.char_of["elyir:c:Q"] = "Q";
global.glyph["R"] = fit(Image("g-82.png")); global.char_of["elyir:c:R"] = "R";
global.glyph["S"] = fit(Image("g-83.png")); global.char_of["elyir:c:S"] = "S";
global.glyph["T"] = fit(Image("g-84.png")); global.char_of["elyir:c:T"] = "T";
global.glyph["U"] = fit(Image("g-85.png")); global.char_of["elyir:c:U"] = "U";
global.glyph["V"] = fit(Image("g-86.png")); global.char_of["elyir:c:V"] = "V";
global.glyph["W"] = fit(Image("g-87.png")); global.char_of["elyir:c:W"] = "W";
global.glyph["X"] = fit(Image("g-88.png")); global.char_of["elyir:c:X"] = "X";
global.glyph["Y"] = fit(Image("g-89.png")); global.char_of["elyir:c:Y"] = "Y";
global.glyph["Z"] = fit(Image("g-90.png")); global.char_of["elyir:c:Z"] = "Z";
global.glyph["0"] = fit(Image("g-48.png")); global.char_of["elyir:c:0"] = "0";
global.glyph["1"] = fit(Image("g-49.png")); global.char_of["elyir:c:1"] = "1";
global.glyph["2"] = fit(Image("g-50.png")); global.char_of["elyir:c:2"] = "2";
global.glyph["3"] = fit(Image("g-51.png")); global.char_of["elyir:c:3"] = "3";
global.glyph["4"] = fit(Image("g-52.png")); global.char_of["elyir:c:4"] = "4";
global.glyph["5"] = fit(Image("g-53.png")); global.char_of["elyir:c:5"] = "5";
global.glyph["6"] = fit(Image("g-54.png")); global.char_of["elyir:c:6"] = "6";
global.glyph["7"] = fit(Image("g-55.png")); global.char_of["elyir:c:7"] = "7";
global.glyph["8"] = fit(Image("g-56.png")); global.char_of["elyir:c:8"] = "8";
global.glyph["9"] = fit(Image("g-57.png")); global.char_of["elyir:c:9"] = "9";
global.glyph["-"] = fit(Image("g-45.png")); global.char_of["elyir:c:-"] = "-";
global.glyph["."] = fit(Image("g-46.png")); global.char_of["elyir:c:."] = ".";
global.glyph[" "] = fit(Image("g-32.png")); global.char_of["elyir:c: "] = " ";
ready_image = fit(Image("ready.png"));
where_image["addr"] = fit(Image("where-cable.png"));
where_image["wifi"] = fit(Image("where-wifi.png"));
where_image["pass"] = fit(Image("where-password.png"));
line = Sprite(); line.SetZ(30); line.SetOpacity(0);
quiet = Sprite(); quiet.SetZ(30); quiet.SetOpacity(0);
ready = Sprite(ready_image); ready.SetZ(30); ready.SetOpacity(0);
ready.SetPosition(Math.Int((screen_w - ready_image.GetWidth()) / 2), Math.Int(oy + 620 * s), 30);

global.frame = 0;
global.name_shown = -1;
global.ready_at = -1;
global.ending_at = -1;
global.widths["none"] = 0;
global.first = 0;
global.step_at = -1;
global.hello_at = -1;
global.field = "";
global.n["addr"] = 0; global.n["wifi"] = 0; global.n["pass"] = 0;
global.shown_n = 0;

fun centered(sprite, image, top) {
  sprite.SetImage(image);
  sprite.SetPosition(Math.Int((screen_w - image.GetWidth()) / 2), Math.Int(oy + top * s), 30);
}

fun step(id) {
  global.first = 1;
  global.step_at = global.frame / 50;
  centered(line, global.step_line[id], 628);
  global.quiet_on = 0;
  if (global.step_quiet[id]) { centered(quiet, global.step_quiet[id], 676); global.quiet_on = 1; }
}

fun piece(image) {
  if (image) { global.pieces[global.piece_n] = image; global.piece_n = global.piece_n + 1; }
}

# A function here is a global like any other, so this one may not share a name with global.field: it was once
# called field, and the first character overwrote it.
fun letters(which) {
  i = 0;
  while (i < global.n[which]) { piece(global.glyph[global.chars[which + "-" + i]]); i = i + 1; }
}

# Where to go next, as one line: the words and this hub's own, side by side and centered together.
fun where() {
  global.piece_n = 0;
  if (global.n["wifi"] > 0) { piece(where_image["wifi"]); letters("wifi"); piece(where_image["pass"]); letters("pass"); }
  else { piece(where_image["addr"]); letters("addr"); }
  w = 0; i = 0;
  while (i < global.piece_n) { w = w + global.pieces[i].GetWidth(); i = i + 1; }
  x = Math.Int((screen_w - w) / 2); i = 0;
  while (i < global.piece_n) {
    if (!global.where_sprite[i]) { global.where_sprite[i] = Sprite(); global.where_sprite[i].SetOpacity(0); }
    global.where_sprite[i].SetImage(global.pieces[i]);
    global.where_sprite[i].SetPosition(x, Math.Int(oy + 678 * s), 31);
    x = x + global.pieces[i].GetWidth(); i = i + 1;
  }
  while (i < global.shown_n) { global.where_sprite[i].SetOpacity(0); i = i + 1; }
  global.shown_n = global.piece_n;
}

fun status(text) {
  if (text == "elyir:ready" && global.ready_at < 0) { global.ready_at = global.frame / 50; }
  if (text == "elyir:step:preparing") { step("preparing"); }
  if (text == "elyir:step:moving") { step("moving"); }
  if (text == "elyir:step:downloading") { step("downloading"); }
  if (text == "elyir:step:starting") { step("starting"); }
  if (text == "elyir:hello") { global.first = 1; global.hello_at = global.frame / 50; }
  if (text == "elyir:addr") { global.field = "addr"; global.n["addr"] = 0; }
  if (text == "elyir:wifi") { global.field = "wifi"; global.n["wifi"] = 0; }
  if (text == "elyir:pass") { global.field = "pass"; global.n["pass"] = 0; }
  # A character of this hub's own, looked up whole: Plymouth's scripts cannot take a status apart.
  c = global.char_of[text];
  if (c && global.field != "") {
    global.chars[global.field + "-" + global.n[global.field]] = c;
    global.n[global.field] = global.n[global.field] + 1;
    where();
  }
}

fun refresh() {
  global.frame = global.frame + 1;
  t = global.frame / 50;
  hello = 0;
  if (global.hello_at >= 0) { hello = ease(ramp(t, global.hello_at, global.hello_at + 0.8)); }

  if (global.ready_at >= 0 && global.ending_at < 0 && t >= ready_after) { global.ending_at = t; }
  out = 0;
  if (global.ending_at >= 0) { out = ease(ramp(t, global.ending_at, global.ending_at + ending)); }
  Window.SetBackgroundTopColor(panel_r * out, panel_g * out, panel_b * out);
  Window.SetBackgroundBottomColor(panel_r * out, panel_g * out, panel_b * out);

  i = Math.Int(t * fps);
  if (i > name_frames - 1) { i = name_frames - 1; }
  if (i != global.name_shown && t < hold + name_out) {
    global.name_image = fit(Image("name-" + pad(i) + ".png"));
    name.SetImage(global.name_image);
    global.name_shown = i;
  }
  name.SetOpacity(1 - ease(ramp(t, hold, hold + name_out)));

  inn = ease(ramp(t, house_in - 0.2, house_in + 0.8));
  grow = (0.96 + 0.04 * inn) * (1 + 0.18 * out);
  house.SetOpacity(inn * (1 - out));
  if (inn > 0) { place("house", house, house_image, house_cx, house_cy, house_size * s * grow); }

  appear = ease(ramp(t, dotted, dotted + 0.3)) * (1 - out);
  k = ease(ramp(t, lit_at, lit_at + 0.8)) * (low + (1 - low) * breath(t));
  if (global.ending_at >= 0) { k = 1; }
  k = k + (1 - k) * hello;
  move = ease(ramp(t, leave, land));
  x = ox + (tittle_x + (lamp_x - tittle_x) * move) * s;
  y = oy + (tittle_y + (lamp_y - tittle_y) * move) * s;
  x = house_cx + (x - house_cx) * (1 + 0.18 * out);
  y = house_cy + (y - house_cy) * (1 + 0.18 * out);
  size = (tittle_size + (lamp_size - tittle_size) * move) * s * (1 + 0.18 * out);
  if (appear > 0) {
    place("unlit", unlit, unlit_image, x, y, size);
    place("dot", dot, dot_image, x, y, size);
    place("dot_glow", dot_glow, dot_glow_image, x, y, size * (32 + 180) / 32);
  }
  unlit.SetOpacity(appear);
  dot.SetOpacity(appear * k);

  # The dot's own small glow gives way to the house's wider one once it has landed.
  landed = ramp(t, land, land + 0.6);
  dot_glow.SetOpacity(appear * k * (1 - landed));
  house_glow.SetOpacity(k * landed * inn * (1 - out));
  if (landed > 0) { place("house_glow", house_glow, house_glow_image, x, y, house_size * 1.1 * s * (1 + 3 * out)); }

  gone = 1 - out;
  if (global.ready_at >= 0) { gone = 0; }
  if (global.first) { gone = 0; }
  slow.SetOpacity(ease(ramp(t, slow_after, slow_after + 1)) * gone);

  # The words wait for the house, and each step's line comes up as the step starts.
  after_house = ease(ramp(t, land, land + 0.6));
  said = 0;
  if (global.step_at >= 0) { said = ease(ramp(t, global.step_at, global.step_at + 0.6)) * after_house * (1 - hello); }
  line.SetOpacity(said);
  quiet.SetOpacity(said * global.quiet_on);
  ready.SetOpacity(hello * after_house);
  i = 0;
  while (i < global.shown_n) { global.where_sprite[i].SetOpacity(hello * after_house); i = i + 1; }
}

Plymouth.SetUpdateStatusFunction(status);
Plymouth.SetRefreshFunction(refresh);
