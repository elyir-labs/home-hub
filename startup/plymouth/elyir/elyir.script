fun centered(sprite, image, top) {
  sprite.SetImage(image);
  sprite.SetPosition(Math.Int((screen_w - image.GetWidth()) / 2), Math.Int(oy + top * s), 30);
}

fun dglyph(set, ch) {
  key = set + ch;
  if (!global.dg[key] && global.cc[ch]) { global.dg[key] = fit(Image(set + "-" + global.cc[ch] + ".png")); }
  return global.dg[key];
}

fun dreg(sprite) {
  sprite.SetOpacity(0);
  global.dl[global.dln] = sprite; global.dw[global.dln] = 0; global.dln = global.dln + 1;
  return global.dln - 1;
}

fun dat(i, image, left, top) {
  global.dl[i].SetImage(image);
  if (left < 0) { global.dl[i].SetPosition(Math.Int((screen_w - image.GetWidth()) / 2), Math.Int(oy + top * s), 32); }
  else { global.dl[i].SetPosition(Math.Int(ox + left * s), Math.Int(oy + top * s), 32); }
  global.dw[i] = 1;
}

# A row of letter pictures under one name, from the left edge given or centered (left < 0); returns its right edge.
fun drow(row, left, top) {
  w = 0; i = 0;
  while (i < global.rpn) { w = w + global.rp[i].GetWidth(); i = i + 1; }
  x = ox + left * s;
  if (left < 0) { x = (screen_w - w) / 2; }
  x = Math.Int(x); i = 0;
  while (i < global.rpn) {
    if (!global.rsi[row + i]) { global.rsi[row + i] = dreg(Sprite()) + 1; }
    j = global.rsi[row + i] - 1;
    global.dl[j].SetImage(global.rp[i]); global.dl[j].SetPosition(x, Math.Int(oy + top * s), 32); global.dw[j] = 1;
    x = x + global.rp[i].GetWidth(); i = i + 1;
  }
  while (global.rsi[row + i]) { global.dw[global.rsi[row + i] - 1] = 0; i = i + 1; }
  global.rpn = 0;
  return x;
}

fun dadd(set, field) {
  i = 0;
  while (i < global.n[field]) {
    g = dglyph(set, global.chars[field + "-" + i]);
    if (g) { global.rp[global.rpn] = g; global.rpn = global.rpn + 1; }
    i = i + 1;
  }
}

# An answer's picture is loaded the first time it is shown.
fun option_image(i, on) {
  key = global.kind + "-" + global.opt[i] + "-" + on;
  if (!global.oi[key]) { global.oi[key] = fit(Image("ask-" + key + ".png")); }
  return global.oi[key];
}

fun ask_layout() {
  if (!global.d_title) {
    global.d_title = dreg(Sprite()) + 1; global.d_card = dreg(Sprite()) + 1; global.d_hint = dreg(Sprite()) + 1;
    global.d_foot = dreg(Sprite()) + 1; global.d_type = dreg(Sprite()) + 1; global.d_entry = dreg(Sprite()) + 1;
    global.d_hold = dreg(Sprite()) + 1; global.d_caret = dreg(Sprite()) + 1; global.d_undone = dreg(Sprite()) + 1;
    global.d_keys = dreg(Sprite()) + 1;
    i = 0; while (i < 4) { global.d_o[i] = dreg(Sprite()) + 1; i = i + 1; }
  }
  i = 0; while (i < global.dln) { global.dw[i] = 0; i = i + 1; }
  card = ask_card[global.kind];
  if (global.page == "erase") { card = drive_card_image; }
  if (global.page == "over") { card = home_card_image; }
  dat(global.d_card - 1, card, 400, 336);
  f = "d";
  if (global.page == "erase") { f = "e"; }
  global.rpn = 0; dadd("m", f + "model"); drow("model", 499, 359);
  global.rpn = 0; dadd("s", f + "sys"); dadd("r", f + "rest"); drow("system", 499, 392);
  if (global.page == "choose") {
    dat(global.d_title - 1, ask_title[global.kind], -1, 268);
    i = 0;
    while (i < global.optn) {
      on = 0;
      if (i == global.pick) { on = 1; }
      dat(global.d_o[i] - 1, option_image(i, on), 400, 476 + i * 92);
      i = i + 1;
    }
    dat(global.d_hint - 1, ask_hint_image, -1, 490 + global.optn * 92);
    dat(global.d_foot - 1, ask_foot[global.kind], -1, 836);
  }
  if (global.page == "erase") {
    dat(global.d_title - 1, drive_sure_image, -1, 268);
    dat(global.d_type - 1, drive_type_image, -1, 462);
    dat(global.d_entry - 1, drive_entry_image, 560, 504);
    e = ""; global.rpn = 0; i = 0;
    while (i < global.n["dtyped"]) {
      ch = global.chars["dtyped-" + i]; e = e + ch;
      g = dglyph("t", ch);
      if (g) { global.rp[global.rpn] = g; global.rpn = global.rpn + 1; }
      i = i + 1;
    }
    right = drow("typed", -1, 517);
    if (global.n["dtyped"] == 0) {
      dat(global.d_hold - 1, drive_hold_image, -1, 517);
      right = (screen_w - drive_hold_image.GetWidth()) / 2;
    }
    global.dl[global.d_caret - 1].SetImage(drive_caret_image);
    global.dl[global.d_caret - 1].SetPosition(Math.Int(right + 3 * s), Math.Int(oy + 521 * s), 32);
    global.dw[global.d_caret - 1] = 1;
    global.rpn = 0; dadd("w", "dwarn"); drow("warn", -1, 600);
    dat(global.d_undone - 1, drive_undone_image, -1, 630.45);
    if (e == "erase") { dat(global.d_keys - 1, drive_sure_keys_image, 400, 700); }
    else { dat(global.d_keys - 1, drive_back_key_image, 400, 700); }
  }
  if (global.page == "over") {
    dat(global.d_title - 1, over_title_image, -1, 268);
    dat(global.d_type - 1, over_warn_image, -1, 492);
    dat(global.d_keys - 1, over_keys_image, 400, 620);
  }
}

fun step(id) {
  global.first = 1;
  if (global.first_at < 0) { global.first_at = global.frame / 50; }
  global.step_at = global.frame / 50;
  centered(line, global.step_line[id], 628);
  global.quiet_on = 0;
  if (global.step_quiet[id]) { centered(quiet, global.step_quiet[id], 676); global.quiet_on = 1; }
}

fun piece(image) {
  if (image) { global.pieces[global.piece_n] = image; global.piece_n = global.piece_n + 1; }
}

# A function here is a global like any other, so this one may not share a name with global.field: it was once
# called field, and the first character overwrote it.
fun letters(which) {
  i = 0;
  while (i < global.n[which]) {
    if (global.coded) { piece(global.small[global.chars[which + "-" + i]]); }
    else { piece(global.glyph[global.chars[which + "-" + i]]); }
    i = i + 1;
  }
}

# Where to go next, as one line: the words and this hub's own, side by side and centered together.
fun where() {
  global.piece_n = 0;
  top = 678;
  if (global.coded) {
    top = 721;
    if (global.n["wifi"] > 0) { piece(or_image["wifi"]); letters("wifi"); piece(or_image["pass"]); letters("pass"); centered(scan_line, scan_image["wifi"], 673); }
    else { piece(or_image["addr"]); letters("addr"); piece(or_image["after"]); centered(scan_line, scan_image["addr"], 673); }
    centered(ready, ready_image, 275);
    # The phone still has the drive's question (B1): Ready says so, over the same code.
    if (global.drive_q) { centered(ready, drive_ready_image, 275); centered(scan_line, drive_scan_image, 673); }
  }
  else {
    centered(ready, ready_image, 620);
    if (global.drive_q) { centered(ready, drive_ready_image, 620); }
    if (global.n["wifi"] > 0) { piece(where_image["wifi"]); letters("wifi"); piece(where_image["pass"]); letters("pass"); }
    else { piece(where_image["addr"]); letters("addr"); }
  }
  w = 0; i = 0;
  while (i < global.piece_n) { w = w + global.pieces[i].GetWidth(); i = i + 1; }
  x = Math.Int((screen_w - w) / 2); i = 0;
  while (i < global.piece_n) {
    if (!global.where_sprite[i]) { global.where_sprite[i] = Sprite(); global.where_sprite[i].SetOpacity(0); }
    global.where_sprite[i].SetImage(global.pieces[i]);
    global.where_sprite[i].SetPosition(x, Math.Int(oy + top * s), 31);
    x = x + global.pieces[i].GetWidth(); i = i + 1;
  }
  while (i < global.shown_n) { global.where_sprite[i].SetOpacity(0); i = i + 1; }
  global.shown_n = global.piece_n;
}

fun status(text) {
  if (text == "elyir:ready" && global.ready_at < 0) { global.ready_at = global.frame / 50; }
  if (text == "elyir:step:preparing") { step("preparing"); }
  if (text == "elyir:step:moving") { step("moving"); }
  if (text == "elyir:step:unpacking") { step("unpacking"); }
  if (text == "elyir:step:setting") { step("setting"); }
  if (text == "elyir:step:downloading") { step("downloading"); }
  if (text == "elyir:step:starting") { step("starting"); }
  if (text == "elyir:step:trying") { step("trying"); }
  if (text == "elyir:step:unasked") { step("unasked"); }
  if (text == "elyir:step:clearing") { step("clearing"); }
  if (text == "elyir:step:todrive") { step("todrive"); }
  if (text == "elyir:hello") { global.first = 1; global.hello_at = global.frame / 50; }
  if (text == "elyir:code") {
    made = Image("../../../../../run/elyir/code.png");
    if (made && made.GetWidth() > 0) {
      w = Math.Int(236 * s);
      code.SetImage(made.Scale(w, w));
      code.SetPosition(Math.Int(ox + 602 * s), Math.Int(oy + 377 * s), 30);
      global.coded = 1;
      where();
    }
  }
  # Ready redrawn for a network that changed under it (say.sh end): the old words go, and the code is replaced.
  if (text == "elyir:clear") { global.field = ""; global.n["addr"] = 0; global.n["wifi"] = 0; global.n["pass"] = 0; where(); }
  if (text == "elyir:nocode") { global.coded = 0; where(); }
  if (text == "elyir:drive:phone") { global.drive_q = 1; where(); }
  if (text == "elyir:drive:none") { global.drive_q = 0; where(); }
  if (text == "elyir:ask:drive") { global.kind = "drive"; global.optn = 0; global.pick = 0; global.page = "choose"; global.n["dtyped"] = 0; global.first = 1; if (!global.asking) { global.asking = 1; global.ask_at = global.frame / 50; } ask_layout(); }
  if (text == "elyir:ask:here") { global.kind = "here"; global.optn = 0; global.pick = 0; global.page = "choose"; global.n["dtyped"] = 0; global.first = 1; if (!global.asking) { global.asking = 1; global.ask_at = global.frame / 50; } ask_layout(); }
  if (text == "elyir:ask:away") { global.kind = "away"; global.optn = 0; global.pick = 0; global.page = "choose"; global.n["dtyped"] = 0; global.first = 1; if (!global.asking) { global.asking = 1; global.ask_at = global.frame / 50; } ask_layout(); }
  if (text == "elyir:ask:hub") { global.kind = "hub"; global.optn = 0; global.pick = 0; global.page = "choose"; global.n["dtyped"] = 0; global.first = 1; if (!global.asking) { global.asking = 1; global.ask_at = global.frame / 50; } ask_layout(); }
  if (text == "elyir:opt:drive:T") { global.opt[global.optn] = "T"; global.optn = global.optn + 1; ask_layout(); }
  if (text == "elyir:opt:drive:E") { global.opt[global.optn] = "E"; global.optn = global.optn + 1; ask_layout(); }
  if (text == "elyir:opt:here:C") { global.opt[global.optn] = "C"; global.optn = global.optn + 1; ask_layout(); }
  if (text == "elyir:opt:here:D") { global.opt[global.optn] = "D"; global.optn = global.optn + 1; ask_layout(); }
  if (text == "elyir:opt:here:S") { global.opt[global.optn] = "S"; global.optn = global.optn + 1; ask_layout(); }
  if (text == "elyir:opt:away:N") { global.opt[global.optn] = "N"; global.optn = global.optn + 1; ask_layout(); }
  if (text == "elyir:opt:away:B") { global.opt[global.optn] = "B"; global.optn = global.optn + 1; ask_layout(); }
  if (text == "elyir:opt:hub:H") { global.opt[global.optn] = "H"; global.optn = global.optn + 1; ask_layout(); }
  if (text == "elyir:opt:hub:T") { global.opt[global.optn] = "T"; global.optn = global.optn + 1; ask_layout(); }
  if (text == "elyir:opt:hub:R") { global.opt[global.optn] = "R"; global.optn = global.optn + 1; ask_layout(); }
  if (text == "elyir:pick:0") { global.pick = 0; ask_layout(); }
  if (text == "elyir:pick:1") { global.pick = 1; ask_layout(); }
  if (text == "elyir:pick:2") { global.pick = 2; ask_layout(); }
  if (text == "elyir:pick:3") { global.pick = 3; ask_layout(); }
  if (text == "elyir:page:choose") { global.page = "choose"; ask_layout(); }
  if (text == "elyir:page:erase") { global.page = "erase"; ask_layout(); }
  if (text == "elyir:page:over") { global.page = "over"; ask_layout(); }
  if (text == "elyir:ask:done") { global.asking = 0; global.done_at = global.frame / 50; }
  if (text == "elyir:dtyped") { global.field = "dtyped"; global.n["dtyped"] = 0; ask_layout(); }
  if (text == "elyir:dmodel") { global.field = "dmodel"; global.n["dmodel"] = 0; }
  if (text == "elyir:dsys") { global.field = "dsys"; global.n["dsys"] = 0; }
  if (text == "elyir:drest") { global.field = "drest"; global.n["drest"] = 0; }
  if (text == "elyir:dwarn") { global.field = "dwarn"; global.n["dwarn"] = 0; }
  if (text == "elyir:emodel") { global.field = "emodel"; global.n["emodel"] = 0; }
  if (text == "elyir:esys") { global.field = "esys"; global.n["esys"] = 0; }
  if (text == "elyir:erest") { global.field = "erest"; global.n["erest"] = 0; }
  if (text == "elyir:addr") { global.field = "addr"; global.n["addr"] = 0; }
  if (text == "elyir:wifi") { global.field = "wifi"; global.n["wifi"] = 0; }
  if (text == "elyir:pass") { global.field = "pass"; global.n["pass"] = 0; }
  # A character of this hub's own, looked up whole: Plymouth's scripts cannot take a status apart.
  c = global.char_of[text];
  if (c && global.field != "") {
    global.chars[global.field + "-" + global.n[global.field]] = c;
    global.n[global.field] = global.n[global.field] + 1;
    if (global.dfield[global.field]) { ask_layout(); } else { where(); }
  }
}

fun refresh() {
  global.frame = global.frame + 1;
  t = global.frame / 50;
  hello = 0;
  if (global.hello_at >= 0) { hello = ease(ramp(t, global.hello_at, global.hello_at + 0.8)); }

  if (global.ready_at >= 0 && global.ending_at < 0 && t >= ready_after) { global.ending_at = t; }
  out = 0;
  if (global.ending_at >= 0) { out = ease(ramp(t, global.ending_at, global.ending_at + ending)); }
  Window.SetBackgroundTopColor(panel_r * out, panel_g * out, panel_b * out);
  Window.SetBackgroundBottomColor(panel_r * out, panel_g * out, panel_b * out);

  i = Math.Int(t * fps);
  if (i > name_frames - 1) { i = name_frames - 1; }
  if (i != global.name_shown && t < hold + name_out) {
    global.name_image = fit(Image("name-" + pad(i) + ".png"));
    name.SetImage(global.name_image);
    global.name_shown = i;
  }
  name.SetOpacity(1 - ease(ramp(t, hold, hold + name_out)));

  inn = ease(ramp(t, house_in - 0.2, house_in + 0.8));
  grow = (0.96 + 0.04 * inn) * (1 + 0.18 * out);
  # With a code, the house rises to the top and gets small (E); everything of it is moved by rise.
  rise = hello * global.coded;
  askv = 0;
  if (global.done_at > 0) { askv = 1 - ease(ramp(t, global.done_at, global.done_at + 0.6)); }
  if (global.asking) { askv = ease(ramp(t, global.ask_at, global.ask_at + 0.6)); }
  up = rise;
  if (askv > up) { up = askv; }
  hs = 1 + (0.3824 - 1) * up;
  hy = house_cy + (oy + 180 * s - house_cy) * up;
  house.SetOpacity(inn * (1 - out));
  if (inn > 0) { place("house", house, house_image, house_cx, hy, house_size * s * grow * hs); }

  appear = ease(ramp(t, dotted, dotted + 0.3)) * (1 - out);
  # A first start pulses deeper and quicker (first-2, C's pulse), blended in so the change is never a jump.
  calm = low + (1 - low) * breath(t, breath_period);
  if (global.first_at >= 0) {
    quick = first_low + (1 - first_low) * breath(t - global.first_at, first_period);
    mix = ease(ramp(t, global.first_at, global.first_at + first_blend));
    calm = calm + (quick - calm) * mix;
  }
  k = ease(ramp(t, lit_at, lit_at + 0.8)) * calm;
  if (global.ending_at >= 0) { k = 1; }
  k = k + (1 - k) * hello;
  k = k + (1 - k) * askv;
  move = ease(ramp(t, leave, land));
  x = ox + (tittle_x + (lamp_x - tittle_x) * move) * s;
  y = oy + (tittle_y + (lamp_y - tittle_y) * move) * s;
  x = house_cx + (x - house_cx) * (1 + 0.18 * out);
  y = house_cy + (y - house_cy) * (1 + 0.18 * out);
  size = (tittle_size + (lamp_size - tittle_size) * move) * s * (1 + 0.18 * out) * hs;
  x = house_cx + (x - house_cx) * hs;
  y = hy + (y - house_cy) * hs;
  if (appear > 0) {
    place("unlit", unlit, unlit_image, x, y, size);
    place("dot", dot, dot_image, x, y, size);
    place("dot_glow", dot_glow, dot_glow_image, x, y, size * (32 + 180) / 32);
  }
  unlit.SetOpacity(appear);
  dot.SetOpacity(appear * k);

  # The dot's own small glow gives way to the house's wider one once it has landed.
  landed = ramp(t, land, land + 0.6);
  dot_glow.SetOpacity(appear * k * (1 - landed));
  house_glow.SetOpacity(k * landed * inn * (1 - out));
  if (landed > 0) { place("house_glow", house_glow, house_glow_image, x, y, house_size * 1.1 * s * (1 + 3 * out) * hs); }

  gone = 1 - out;
  if (global.ready_at >= 0) { gone = 0; }
  if (global.first) { gone = 0; }
  slow.SetOpacity(ease(ramp(t, slow_after, slow_after + 1)) * gone);

  # The words wait for the house, and each step's line comes up as the step starts.
  after_house = ease(ramp(t, land, land + 0.6));
  said = 0;
  if (global.step_at >= 0) { said = ease(ramp(t, global.step_at, global.step_at + 0.6)) * after_house * (1 - hello); }
  line.SetOpacity(said * (1 - askv));
  quiet.SetOpacity(said * global.quiet_on * (1 - askv));
  i = 0;
  while (i < global.dln) { global.dl[i].SetOpacity(global.dw[i] * askv * after_house); i = i + 1; }
  ready.SetOpacity(hello * after_house);
  tile.SetOpacity(rise * after_house);
  code.SetOpacity(rise * after_house);
  scan_line.SetOpacity(rise * after_house);
  i = 0;
  while (i < global.shown_n) { global.where_sprite[i].SetOpacity(hello * after_house); i = i + 1; }
}

Plymouth.SetUpdateStatusFunction(status);
Plymouth.SetRefreshFunction(refresh);
